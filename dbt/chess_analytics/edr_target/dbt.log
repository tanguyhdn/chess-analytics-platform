{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.7\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"750c431e-0111-4e86-ac1f-adb15df4df60\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n  select\n    elementary_test_results_id,\n    result_row\n  from `chess-analytics-platform`.`chess_staging`.`test_result_rows`\n  where detected_at > \n        timestamp_add(\n            cast(current_timestamp as timestamp),\n            interval cast(-7 as INT64) day\n        )\n\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from `chess-analytics-platform`.`chess_staging`.`ordered_test_results__tmp_20260415215417280527`\n        where invocations_rank_index = 1\n    )\n  \n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "750c431e-0111-4e86-ac1f-adb15df4df60", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.7\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"750c431e-0111-4e86-ac1f-adb15df4df60\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n  select\n    elementary_test_results_id,\n    result_row\n  from `chess-analytics-platform`.`chess_staging`.`test_result_rows`\n  where detected_at > \n        timestamp_add(\n            cast(current_timestamp as timestamp),\n            interval cast(-7 as INT64) day\n        )\n\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from `chess-analytics-platform`.`chess_staging`.`ordered_test_results__tmp_20260415215417280527`\n        where invocations_rank_index = 1\n    )\n  \n  \n\n  ", "name": "SQLQuery", "pid": 182176, "thread": "MainThread", "ts": "2026-04-15T21:54:20.353128Z"}}
