# ─────────────────────────────────────────────────────
# CHESS ANALYTICS PLATFORM — Environment Variables
# ─────────────────────────────────────────────────────
# Copie ce fichier en .env et remplis les valeurs
# Ne commite JAMAIS le fichier .env sur Git
# ─────────────────────────────────────────────────────

# ─── Google Cloud Platform ────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json

# ─── BigQuery Datasets ────────────────────────────────
BQ_DATASET_RAW=chess_raw
BQ_DATASET_STAGING=chess_staging
BQ_DATASET_MARTS=chess_marts

# ─── Chess.com API ────────────────────────────────────
# Pas de clé requise — juste un User-Agent identifiable
CHESSCOM_USER_AGENT=ChessAnalyticsPlatform/1.0 contact@youremail.com

# ─── Kafka ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MOVES=chess.moves.live
KAFKA_TOPIC_GAMES=chess.game.events

# ─── Airflow ──────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=your-secure-password

# ─── Streamlit ────────────────────────────────────────
STREAMLIT_BQ_PROJECT=your-gcp-project-id